# Public client configuration. Never commit production credentials in .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
WEATHER_API_KEY=your_weatherapi_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
SENTRY_DSN=
APP_ENVIRONMENT=development
# Development/internal builds only. Production code ignores this flag.
DEMO_MODE=false

# Model training (services/prediction). train_from_parquet.py sets these from --seed,
# so they are documented here for reference and need not be exported.
# PYTHONHASHSEED=42
# TF_DETERMINISTIC_OPS=1
